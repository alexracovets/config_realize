SHOPIFY_ENABLED=true
SHOPIFY_API_VERSION=2025-01

APP_ORIGIN=https://your-app-domain.com

SHOPIFY_STORE_DOMAIN=realize2-0.myshopify.com
SHOPIFY_ADMIN_STORE_DOMAIN=realize2-0.myshopify.com
SHOPIFY_HOSTS=realize2-0.myshopify.com

SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API: Dev Dashboard app (client_credentials, token auto-refreshed ~24h).
# SHOPIFY_ADMIN_CLIENT_SECRET also verifies orders/create webhook HMAC.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Or a classic custom-app static token instead of CLIENT_ID/SECRET:
# SHOPIFY_ADMIN_ACCESS_TOKEN=

SHOPIFY_FRAME_ANCESTORS=https://realize2-0.myshopify.com
REDIS_URL=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_NOTIFICATION_EMAIL=
MAIL_TEST_REDIRECT_EMAIL=
